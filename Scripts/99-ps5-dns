#!/bin/sh
# 默认添加 PS5 DNS 劫持规则（用于 PS5 越狱，用户指南重定向）
# 首次开机自动执行

# manuals.playstation.net -> 140.245.119.225（PS5 用户指南劫持入口）
uci -q delete dhcp.@dnsmasq[0].address
uci add_list dhcp.@dnsmasq[0].address='/manuals.playstation.net/140.245.119.225'
uci commit dhcp
/etc/init.d/dnsmasq reload >/dev/null 2>&1
exit 0
